---
/**
 * Landing page. Ports the Starlight `template: splash` home: hero tagline,
 * two calls to action, and the "Why binaries" card grid. Nimbus has no
 * splash template — landing pages are just Astro pages — so the hero is
 * authored here and the cards reuse the same <Card>/<CardGrid> the docs use.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { Card } from "../components/ui/card";
import { CardGrid } from "../components/ui/card-grid";
import { LinkButton } from "../components/ui/link-button";
import { config } from "virtual:nimbus/config";

const tagline =
  "Deploy single-binary web apps to your own VPS. No Docker, no registry, no runtime on the server. One command hardens a fresh box; one command deploys.";
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header showSidebar={false} />
    <main id="main-content" tabindex="-1" class="flex-1 mx-auto max-w-3xl w-full px-6 py-20">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {config.title}
      </h1>
      <p class="mt-3 text-[1.0625rem] text-muted-foreground leading-relaxed">
        {tagline}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <LinkButton href="/quick-start" variant="primary" size="lg" icon>
          Get started
        </LinkButton>
        {config.github && (
          <LinkButton
            href={config.github}
            variant="secondary"
            size="lg"
            target="_blank"
            rel="noopener"
          >
            View on GitHub
          </LinkButton>
        )}
      </div>

      <h2 class="mt-16 text-xl font-semibold text-foreground">Why binaries</h2>
      <CardGrid class="mt-4">
        <Card title="Nothing on the server" icon="ph:hard-drives">
          The box runs SSH and Caddy; your app is one executable behind a health check.
        </Card>
        <Card title="Atomic deploys" icon="ph:arrows-left-right">
          Upload beside the old release, health-check, flip a symlink. Rollback is flipping it back.
        </Card>
        <Card title="Hardened by default" icon="ph:shield-check">
          Bootstrap sets up key-only SSH, no root login, a firewall, fail2ban, auto security updates.
        </Card>
        <Card title="Your keys, your box" icon="ph:key">
          Secrets travel over ssh stdin, never argv or git. A leaked CI key is scoped to one app.
        </Card>
      </CardGrid>
    </main>
  </div>
</BaseLayout>
