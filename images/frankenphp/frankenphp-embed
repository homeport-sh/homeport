#!/bin/bash
# frankenphp-embed <app dir> <output> — embed a PHP app into a static
# FrankenPHP: the app as app.tar (what static-php-cli's --with-frankenphp-app
# does), then the link static-php-cli runs, against the PHP this image built.
# HOMEPORT_FRANKENPHP_PGO=0 links without the profile (faster to build).
set -euo pipefail
app=$(cd "${1:?usage: frankenphp-embed <app dir> <output>}" && pwd)
out=${2:?usage: frankenphp-embed <app dir> <output>}
[[ $out == /* ]] || out=$PWD/$out
S=/go/src/app/dist/static-php-cli
H=/opt/homeport
cd /go/src/app
tar -cf app.tar --exclude=./.git --exclude=./node_modules --exclude=./tests -C "$app" .
md5sum app.tar | cut -d' ' -f1 > app.checksum
export PATH=$S/pkgroot/x86_64-linux/go-xcaddy/bin:$S/pkgroot/x86_64-linux/bin:$S/buildroot/bin:$PATH
export GOROOT=$S/pkgroot/x86_64-linux/go-xcaddy
dyn=""
[[ -f $S/buildroot/lib/libphp.a.dynsym ]] && dyn="-Wl,--dynamic-list=$S/buildroot/lib/libphp.a.dynsym"
export CGO_ENABLED=1
export CGO_CFLAGS="$(cat $H/cflags) -fPIE -fstack-protector-strong -O2 -w -s -DFRANKENPHP_VERSION=$FRANKENPHP_VERSION"
export CGO_LDFLAGS="-static-pie $(cat $H/libs)"
export LD_LIBRARY_PATH=$S/buildroot/lib
export XCADDY_GO_BUILD_FLAGS="-buildmode=pie -ldflags \"-linkmode=external -extldflags '-static-pie -Wl,-z,stack-size=0x80000 $dyn' -X 'github.com/caddyserver/caddy/v2/modules/caddyhttp.ServerHeader=FrankenPHP Caddy' -X 'github.com/caddyserver/caddy/v2.CustomBinaryName=frankenphp' -X 'github.com/caddyserver/caddy/v2.CustomVersion=FrankenPHP v$FRANKENPHP_VERSION PHP $PHP_VERSION Caddy'\" -tags=static_build,nobadger,nomysql,nopgx,deprecated_topic,deprecated_claim"
cmd=$(cat $H/xcaddy.cmd)
[[ ${HOMEPORT_FRANKENPHP_PGO:-1} == 0 ]] && cmd=$(sed -E 's/ --pgo [^ ]+//' <<<"$cmd")
work=$(mktemp -d)
cd "$work"
eval "$cmd" >&2
mv frankenphp "$out"
rm -rf "$work" /go/src/app/app.tar /go/src/app/app.checksum
